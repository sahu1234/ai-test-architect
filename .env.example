# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model identifier (default: gemini-4-hydrogen)
GEMINI_MODEL="gemini-4-hydrogen"

# AI_PROVIDER: "auto" (uses gemini when GEMINI_API_KEY is valid, else explicit deterministic mock demo mode), "gemini", or "mock"
AI_PROVIDER="auto"

# DATABASE_URL: Local SQLite database path for Prisma ORM
DATABASE_URL="file:./dev.db"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# ALLOWED_TARGET_ORIGINS: Optional comma-separated list of additional origins allowed for Playwright exploration
ALLOWED_TARGET_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
